# Aplicação
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=seno
DB_PASSWORD=seno
DB_NAME=seno
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# JWT / Autenticação
JWT_SECRET=dev-only-secret-please-override-in-production-32bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
JWT_ISSUER=seno

# CORS (lista separada por vírgulas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
