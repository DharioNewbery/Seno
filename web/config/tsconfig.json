// A base (paths, rootDirs, types $app/*) é gerada pelo `svelte-kit sync`
// em node_modules/$app/tsconfig.json; aqui ficam apenas as escolhas do projeto.
{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
