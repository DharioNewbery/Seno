# ============================================================================
# Seno — Variáveis de Ambiente
# ============================================================================
# Como usar: Copie este arquivo para `.env` e preencha os valores de acordo
# com o seu ambiente. NUNCA comite o arquivo `.env` para o repositório.

# ----------------------------------------------------------------------------
# API (Go)
# ----------------------------------------------------------------------------
# Porta/endereço onde a API irá rodar.
SENO_ADDR=:8080

# String de conexão principal do banco de dados da API.
SENO_DATABASE_URL=postgres://seno:seno@localhost:5432/seno?sslmode=disable

# Controle de expiração das sessões de usuário (janela deslizante e limite máximo absoluto).
SENO_SESSION_TTL=12h
SENO_SESSION_MAX_TTL=168h

# Credenciais do administrador do sistema (criado no banco ao iniciar a aplicação).
SENO_SUPER_EMAIL=super@seno.dev
SENO_SUPER_PASSWORD=102938

# URL pública de acesso ao frontend (usada para CORS e geração de links nos e-mails).
SENO_WEB_ORIGIN=http://localhost:5173

# URLs de comunicação da API com o serviço do Monitor.
# SENO_MONITOR_URL: Como a API enxerga o Monitor (rede interna/Docker).
# SENO_MONITOR_PUBLIC_URL: Como o navegador enxerga o Monitor.
SENO_MONITOR_URL=http://localhost:8081
SENO_MONITOR_PUBLIC_URL=http://localhost:8081

# Intervalo em segundos que a API consulta o estado das atividades no Monitor.
SENO_POLL_ESTADO_S=30

# Credenciais SMTP para envio de e-mails (pode ser substituído por chaves de API depois).
SENO_SMTP_HOST=localhost
SENO_SMTP_PORT=1025
SENO_SMTP_USER=
SENO_SMTP_PASSWORD=
SENO_SMTP_FROM=seno@ufpa.br

# ----------------------------------------------------------------------------
# Monitor (Serviço de Realização)
# ----------------------------------------------------------------------------
# Porta/endereço onde o serviço do Monitor irá rodar.
SENO_MONITOR_ADDR=:8081

# String de conexão do banco de dados exclusivo do Monitor.
SENO_MONITOR_DSN=postgres://seno:seno@localhost:5432/seno_monitor?sslmode=disable

# Chave de segurança para validar a comunicação entre API e Monitor (mínimo 32 bytes).
SENO_MONITOR_SECRET=troque-por-segredo-aleatorio-de-32-bytes-no-minimo!!

# Tolerância em segundos para assinaturas HMAC (previne ataques de repetição).
SENO_MONITOR_HMAC_JANELA_S=60

# Habilita a flag "Secure" nos cookies (true = exige HTTPS em produção, false = HTTP local).
SENO_COOKIE_SECURE=false

# URL pública do frontend usada pelo Monitor para realizar os redirecionamentos do usuário.
SENO_WEB_URL=http://localhost:5173

# Limites operacionais do Monitor
SENO_MONITOR_MAX_PAYLOAD_BYTES=1048576       # Tamanho máximo de dados trafegados
SENO_SNAPSHOT_INTERVALO_S=60                 # Tempo entre os salvamentos do editor
SENO_MONITOR_MAX_SNAPSHOT_BYTES=262144       # Tamanho limite de cada salvamento
SENO_TOKEN_SSO_TTL_S=300                     # Validade do token de navegação única (SSO)
SENO_PRE_AVA_TTL_S=900                       # Validade do estado de sala de espera
SENO_ALUNO_EXEC_MAX_PER_MIN=5                # Rate limit de execuções de código por aluno

# Retenção de dados (dias de armazenamento antes da limpeza automática)
SENO_EXECUCAO_RETENCAO_D=7                   # Histórico efêmero de códigos rodados
SENO_RETENCAO_DADOS_D=730                    # Logs de sistema e submissões

# Integrações Judge0 (Compilador de Código)
# URL e token de acesso da sua instância do Judge0.
SENO_JUDGE0_URL=http://localhost:2358
SENO_JUDGE0_TOKEN=

# Configuração de recebimento dos resultados (webhooks) pelo Monitor.
SENO_JUDGE0_CALLBACK_SECRET=dev-callback-secret-judge0
SENO_MONITOR_CALLBACK_URL=http://host.docker.internal:8081

# Configuração de recebimento dos resultados (webhooks) pela API (Auto-correção).
SENO_JUDGE0_CALLBACK_KEY=dev-callback-key-api-judge0
SENO_JUDGE0_CALLBACK_URL=http://host.docker.internal:8080

# ----------------------------------------------------------------------------
# Web / BFF (SvelteKit)
# ----------------------------------------------------------------------------
# URL da API como o servidor Node (backend do frontend) a acessa.
# No Docker, use o nome do container (ex: http://api:8080).
SENO_API_URL=http://localhost:8080

# Porta que o servidor SvelteKit vai expor.
PORT=3000

# ----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL via Docker Compose)
# ----------------------------------------------------------------------------
# Credenciais base para a inicialização do container do Postgres.
POSTGRES_DB=seno
POSTGRES_USER=seno
POSTGRES_PASSWORD=seno

# ----------------------------------------------------------------------------
# Proxy / Caddy (Deploy Produção)
# ----------------------------------------------------------------------------
# Domínio público principal usado para gerar os certificados SSL automáticos.
SENO_DOMAIN=seno.ufpa.br