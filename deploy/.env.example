# ============================================================================
# Seno — Variáveis de Ambiente
# ============================================================================
# Em produção (Linux), execute `./deploy/deploy.sh` para gerar segredos e
# preencher este arquivo automaticamente de forma interativa.
# Para desenvolvimento local, copie este arquivo para `deploy/.env`.
# NUNCA comite `deploy/.env` no repositório.

# ----------------------------------------------------------------------------
# API (Go)
# ----------------------------------------------------------------------------
# Porta/endereço onde a API irá escutar.
SENO_ADDR=:8080

# String de conexão principal do banco de dados da API (compose sobrescreve).
SENO_DATABASE_URL=postgres://seno:seno@localhost:5432/seno?sslmode=disable

# Controle de expiração das sessões de usuário.
SENO_SESSION_TTL=12h
SENO_SESSION_MAX_TTL=168h

# Credenciais do super administrador inicial (criado no boot da API).
SENO_SUPER_EMAIL=super@seno.dev
SENO_SUPER_PASSWORD=102938

# URL pública canônica do frontend (usada para links em e-mails e validação CSRF).
# Em produção atrás de proxy, ex.: https://seno.ufpa.br ou https://192.168.100.161:8443
SENO_WEB_ORIGIN=http://localhost:5173

# URLs de comunicação com o Monitor:
# SENO_MONITOR_URL: endereço interno (no compose é http://monitor:8081).
# SENO_MONITOR_PUBLIC_URL: caminho/URL visto pelo navegador (em produção use /monitor).
SENO_MONITOR_URL=http://localhost:8081
SENO_MONITOR_PUBLIC_URL=http://localhost:8081

# Intervalo em segundos que a API consulta o estado das atividades no Monitor.
SENO_POLL_ESTADO_S=30

# Credenciais SMTP para envio de e-mails (deixe SENO_SMTP_HOST vazio em produção
# para usar o fallback operacional no Log de auditoria).
SENO_SMTP_HOST=localhost
SENO_SMTP_PORT=1025
SENO_SMTP_USER=
SENO_SMTP_PASSWORD=
SENO_SMTP_FROM=seno@ufpa.br

# ----------------------------------------------------------------------------
# Monitor (Serviço de Realização)
# ----------------------------------------------------------------------------
SENO_MONITOR_ADDR=:8081

# DSN exclusivo do Monitor (compose sobrescreve para o banco seno_monitor).
SENO_MONITOR_DSN=postgres://seno:seno@localhost:5432/seno_monitor?sslmode=disable

# Segredo HMAC compartilhado entre API e Monitor (mínimo 32 bytes).
SENO_MONITOR_SECRET=troque-por-segredo-aleatorio-de-32-bytes-no-minimo!!
SENO_MONITOR_HMAC_JANELA_S=60

# Flag Secure nos cookies (true = HTTPS em produção; false = HTTP puro).
SENO_COOKIE_SECURE=false

# Base pública do portal web vista pelo navegador (vazio em produção atrás do
# Caddy para usar caminhos relativos dinâmicos no mesmo host/IP/porta).
SENO_WEB_URL=http://localhost:5173

# Limites operacionais do Monitor
SENO_MONITOR_MAX_PAYLOAD_BYTES=1048576
SENO_SNAPSHOT_INTERVALO_S=60
SENO_MONITOR_MAX_SNAPSHOT_BYTES=262144
SENO_TOKEN_SSO_TTL_S=300
SENO_PRE_AVA_TTL_S=900
SENO_ALUNO_EXEC_MAX_PER_MIN=5

# Retenção de dados (dias)
SENO_EXECUCAO_RETENCAO_D=7
SENO_RETENCAO_DADOS_D=730

# Integração Judge0 (no compose os endereços internos já são sobrescritos)
SENO_JUDGE0_URL=http://localhost:2358
SENO_JUDGE0_TOKEN=
SENO_JUDGE0_CALLBACK_SECRET=dev-callback-secret-judge0
SENO_MONITOR_CALLBACK_URL=http://host.docker.internal:8081
SENO_JUDGE0_CALLBACK_KEY=dev-callback-key-api-judge0
SENO_JUDGE0_CALLBACK_URL=http://host.docker.internal:8080

# ----------------------------------------------------------------------------
# Web / BFF (SvelteKit)
# ----------------------------------------------------------------------------
SENO_API_URL=http://localhost:8080
PORT=3000
SENO_WEB_BODY_LIMIT=16M

# ----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL via Docker Compose)
# ----------------------------------------------------------------------------
POSTGRES_DB=seno
POSTGRES_USER=seno
POSTGRES_PASSWORD=seno

# ----------------------------------------------------------------------------
# Proxy / Caddy e Deploy Produção
# ----------------------------------------------------------------------------
# Host principal (domínio ou IP da máquina) e portas públicas do Caddy.
SENO_DOMAIN=seno.ufpa.br
SENO_HTTP_PORT=80
SENO_HTTPS_PORT=443
# Sufixo da porta HTTPS no redirecionamento HTTP->HTTPS (vazio para 443; ex.: :8443).
SENO_HTTPS_PORT_SUFFIX=
# Redes/IPs de proxies reversos externos confiáveis pelo Caddy (padrão: private_ranges).
SENO_TRUSTED_PROXIES=private_ranges
# Define se o Caddy sobe com TLS (true) ou HTTP puro (false).
SENO_TLS_ENABLED=true
# Flag gravada pelo deploy.sh indicando que a configuração inicial foi concluída.
SENO_DEPLOY_CONFIGURED=false
