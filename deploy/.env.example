# ============================================================================
# Seno — variáveis de ambiente (cópia como `.env`; NUNCA comitar .env)
# ============================================================================
# Desenvolvimento: copie para deploy/.env antes de subir compose.dev.yaml
# Produção: todos os valores abaixo são obrigatórios no servidor.

# ----------------------------------------------------------------------------
# API (Go)
# ----------------------------------------------------------------------------
# Endereço HTTP da API (interno; atrás de Caddy).
SENO_ADDR=:8080

# DSN do PostgreSQL. Em dev: postgres://seno:seno@localhost:5432/seno?sslmode=disable
SENO_DATABASE_URL=postgres://seno:seno@postgres:5432/seno?sslmode=disable

# TTL de sessão: janela sliding e teto (padrões da Arquitetura §5.2).
SENO_SESSION_TTL=12h
SENO_SESSION_MAX_TTL=168h

# Bootstrap do SUPER admin (criado na inicialização se não existir).
SENO_SUPER_EMAIL=super@seno.dev
SENO_SUPER_PASSWORD=102938

# Origem pública do web (usada para links de convite/recuperação e guarda de Origin).
SENO_WEB_ORIGIN=http://localhost:5173

# SMTP da UFPA (em dev: MailPit; CAMPO a definir — PONTO ABERTO da Arquitetura §10)
SENO_SMTP_HOST=localhost
SENO_SMTP_PORT=1025
SENO_SMTP_USER=
SENO_SMTP_PASSWORD=
SENO_SMTP_FROM=seno@ufpa.br

# ============================================================================
# Monitor (serviço novo de realização, ver docs/MONITOR_FLUXO_ALUNO.md)
# Em dev roda nativamente: cd monitor && go run ./cmd/monitor
# ============================================================================
# Endereço HTTP do Monitor (interno; para o Caddy quando houver rota).
SENO_MONITOR_ADDR=:8081

# DSN do banco próprio do Monitor (mesmo servidor do dev, banco separado).
SENO_DATABASE_URL=postgres://seno:seno@localhost:5432/seno_monitor?sslmode=disable

# HMAC compartilhado com a API (rotas internas + SSO). >= 32 bytes.
SENO_MONITOR_SECRET=troque-por-segredo-aleatorio-de-32-bytes-no-minimo!!

# Janela de tolerância de relógio nas rotas internas (anti-replay). O MAC do
# contrato cobre tempo+corpo (desvio documentado da spec §2 — p/ replay real).
SENO_MONITOR_HMAC_JANELA_S=60

# Secure do cookie hm_sess: true em produção (HTTPS); false no dev HTTP localhost.
SENO_COOKIE_SECURE=false

# Limiares da spec §7:
SENO_MONITOR_MAX_PAYLOAD_BYTES=1048576
SENO_SNAPSHOT_INTERVALO_S=60
SENO_MONITOR_MAX_SNAPSHOT_BYTES=262144
SENO_TOKEN_SSO_TTL_S=300
SENO_PRE_AVA_TTL_S=900
SENO_ALUNO_EXEC_MAX_PER_MIN=5
SENO_EXECUCAO_RETENCAO_D=7

# Retenção LGPD (§9.2): log e submissão do Monitor, em dias. Padrão 730 (2 anos).
SENO_RETENCAO_DADOS_D=730

# Judge0 (Fase 5; em dev a instância local: deploy/judge0/):
SENO_JUDGE0_URL=http://localhost:2358
SENO_JUDGE0_TOKEN=
# Segredo que o Monitor valida no callback do Judge0 (?key=...).
SENO_JUDGE0_CALLBACK_SECRET=dev-callback-secret-judge0
# Base do Monitor como o Judge0 a alcança (callback_url): em dev com
# Monitor nativo no Windows, host.docker.internal; em produção, a rede interna.
SENO_MONITOR_CALLBACK_URL=http://host.docker.internal:8081

# ----------------------------------------------------------------------------
# Web / BFF (SvelteKit, adapter-node)
# ----------------------------------------------------------------------------
# Endereço da API visto pelo servidor do SvelteKit.
SENO_API_URL=http://api:8080

# Porta do servidor node do adapter-node.
PORT=3000

# ----------------------------------------------------------------------------
# PostgreSQL (compose)
# ----------------------------------------------------------------------------
POSTGRES_DB=seno
POSTGRES_USER=seno
POSTGRES_PASSWORD=seno

# ----------------------------------------------------------------------------
# Caddy (produção)
# ----------------------------------------------------------------------------
SENO_DOMAIN=seno.ufpa.br
